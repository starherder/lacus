<?xml version="1.0" encoding="utf-8"?>

<form name="form_entry" maximize="true" accept_event="false" >
    <hlayout accept_event="false" ground_color="#00558855" >
        <vlayout name="vlay_main" size="500, 0" pad="30,30" ground_color="#005588DD" border_color="#000000FF" border_size="2">
            <label name="lbl_scene_icon" size="0,550" texture="textures/UI/tiger.svg" ground_color="#FF5555DD" border_color="#000000FF" border_size="2"/>
            <text name="txt_scene_desc" size="0,300" text="dangerouse! keeep away!" text_color="#FFFFFFFF" font_size="30" border_size="1"/>
            <card_group name="card_group" can_dropin="true" />
            <hlayout name="hlay_footer" size="0, 80" border_color="#000000DD" border_size="1" >
                <button name="btn_enter" text="enter" />
                <button name="btn_cards" text="cards" />
                <button name="btn_leave" text="leave" />
            </hlayout>
        </vlayout>
        <group accept_event="false" ground_color="#88005555" />
    </hlayout>
</form>