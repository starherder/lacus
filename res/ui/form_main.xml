  <?xml version="1.0" encoding="utf-8"?>

  <form maximize="true" accept_event="false" >
    <vlayout accept_event="false">
      <hlayout name="dump_space" size="0,50" />
      <hlayout name="hlay_title" size="0,50" >
        <widget accept_event="false"/>
        <button name="btn_scenes" size="100,50" text="场景" text_color="#555555FF" text_font="fonts/msyh.ttf" font_size="20" />
        <button name="btn_config" size="100,50" text="配置" text_color="#555555FF" text_font="fonts/msyh.ttf" font_size="20" />
        <button name="btn_close" size="100,50" text="退出" text_color="#555555FF" text_font="fonts/msyh.ttf" font_size="20" />
      </hlayout>
  
      <widget name="wgt_scene" accept_event="false" can_dropin="true" />

        <hlayout name="hlay_tools" size="0,200" clip_children="false" accept_event="false">
          <group size ="200,0" ground_color="#8888FF00" border_color="#00000000" border_size="1" />
            <card_group name="card_group" size="0,150" can_dropin="true" ground_color="#22882200" border_color="#00000000" border_size="1"  overlap="true">
              <card name="test_card" size="150,200" ground_color="#8888FFFF" border_color="#000099FF" border_size="1" border_round="10" can_dragout="true">
                <vlayout name="cards-test" pad="5,5" accept_event="false">
                  <hlayout size="0,25" accept_event="false">
                    <label name="lbl_name" size="50,0" text="zhangsan" text_color="#222222FF" font_size="12" accept_event="false"/>
                    <widget accept_event="false"/>
                    <label name="lbl_level" size="50,0" text="lv.43" text_color="#008800FF" font_size="10" accept_event="false"/>
                  </hlayout>
                  <hlayout size="0,100" accept_event="false">
                    <widget  accept_event="false"/>
                    <label name="lbl_icon" size="100,0" texture="ui:one-0" ground_color="#FFFFFFFF" border_color="#FFFFFFFF" border_round="5" border_size="3"  accept_event="false"/>
                    <widget  accept_event="false"/>
                  </hlayout>
                  <hlayout>
                    <widget size="5,0"/>
                    <text name="txt_desc" text="zhangsan is a good man" ground_color="#AAAAAAFF" text_color="#555555FF" font_size="10"  accept_event="false"/>
                    <widget size="5,0"/>
                  </hlayout>
                </vlayout>
              </card>
            </card_group >
          <group size ="300,0" ground_color="#88FFFF00" border_color="#00000000" border_size="1" />
        </hlayout>
    </vlayout>
  </form>