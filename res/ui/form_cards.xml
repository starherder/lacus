<?xml version="1.0" encoding="utf-8"?>

<form maximize="true" size="600,600" ground_color="#005555FF" border_color="#555555FF" border_size="1">
    <vlayout name="vlay_bg" ground_color="#555FF5DD" border_color="#555555FF" border_size="1">
        <widget size="0, 50" />
        <hlayout name="hlay_title" size="0,50" >
            <widget />
            <label name="lbl_txt" size="200,0" text="cards" text_color="#FFCCAAFF" font_name="fonts/Vonwaon.ttf" font_size="30" />
            <widget />
            <button name="btn_close" size="100,50" text="关闭"  text_color="#FFFFFFFF" font_name="fonts/msyh.ttf" font_size="20" />
        </hlayout>

        <widget />

        <hlayout name="hlay_card_desc" pad="20,20" size="0,400">
            <widget />
            <label name="lbl_card_1" size="300,0" ground_color="#8888FFFF" border_color="#000000FF" border_size="1" />
            <label name="lbl_card_1" size="300,0" ground_color="#8888FFFF" border_color="#000000FF" border_size="1" />
            <!--label name="lbl_card_1" size="300,0" ground_color="#8888FFFF" border_color="#000000FF" border_size="1" /-->
       
                <card name="test_card" size="300,400" ground_color="#8888FFFF" border_color="#000099FF" border_size="1" border_round="10" can_dragout="true">
                    <vlayout name="cards-test" pad="10,10" accept_event="false">
                        <hlayout size="0,50" accept_event="false">
                            <label name="lbl_name" size="100,0" text="zhangsan" text_color="#222222FF" font_name="fonts/Vonwaon.ttf" font_size="25" accept_event="false"/>
                            <widget  accept_event="false"/>
                            <label name="lbl_level" size="100,0" text="lv.43" text_color="#008800FF" font_name="fonts/Vonwaon.ttf" font_size="20" accept_event="false"/>
                        </hlayout>
                        <hlayout size="0,200" accept_event="false">
                            <widget  accept_event="false"/>
                            <label name="lbl_icon" size="200,0" texture="ui:one-0" ground_color="#FFFFFFFF" border_color="#FFFFFFFF" border_round="5" border_size="3"  accept_event="false"/>
                            <widget  accept_event="false"/>
                        </hlayout>
                        <hlayout>
                            <widget size="10,0"/>
                            <text name="txt_desc" text="zhangsan is a good man" ground_color="#AAAAAAFF" text_color="#FFFFFFFF" font_name="fonts/msyh.ttf" font_size="20"  accept_event="false"/>
                            <widget size="10,0"/>
                        </hlayout>
                    </vlayout>
                </card>

            <widget />
        </hlayout>

        <hlayout >
        </hlayout>

        <card_group name="card_group" size="0,200" can_dropin="true" ground_color="#228822FF" border_color="#000000FF" border_size="1"  overlap="true">
          
                <card name="test_card" size="250,350" ground_color="#8888FFFF" border_color="#000099FF" border_size="1" border_round="10" can_dragout="true">
                    <vlayout name="cards-test" pad="10,10" accept_event="false">
                        <hlayout size="0,50" accept_event="false">
                            <label name="lbl_name" size="100,0" text="zhangsan" text_color="#222222FF" font_name="fonts/Vonwaon.ttf" font_size="25" accept_event="false"/>
                            <widget  accept_event="false"/>
                            <label name="lbl_level" size="100,0" text="lv.43" text_color="#008800FF" font_name="fonts/Vonwaon.ttf" font_size="20" accept_event="false"/>
                        </hlayout>
                        <hlayout size="0,200" accept_event="false">
                            <widget  accept_event="false"/>
                            <label name="lbl_icon" size="200,0" texture="ui:one-0" ground_color="#FFFFFFFF" border_color="#FFFFFFFF" border_round="5" border_size="3"  accept_event="false"/>
                            <widget  accept_event="false"/>
                        </hlayout>
                        <hlayout>
                            <widget size="10,0"/>
                            <text name="txt_desc" text="zhangsan is a good man" ground_color="#AAAAAAFF" text_color="#FFFFFFFF" font_name="fonts/msyh.ttf" font_size="20"  accept_event="false"/>
                            <widget size="10,0"/>
                        </hlayout>
                    </vlayout>
                </card>

        </card_group >
    </vlayout>
</form>