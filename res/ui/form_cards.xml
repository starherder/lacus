<?xml version="1.0" encoding="utf-8"?>

<form maximize="true" size="600,600" ground_color="#005555FF" border_color="#555555FF" border_size="1">
    <vlayout name="vlay_bg" ground_color="#555FF5DD" border_color="#555555FF" border_size="1">
        <widget size="0, 50" />
        <hlayout name="hlay_title" size="0,50" >
            <widget />
            <label name="lbl_txt" size="200,0" text="cards" text_color="#FFCCAAFF" font_name="fonts/Vonwaon.ttf" font_size="30" />
            <widget />
            <button name="btn_confirm" size="100,50" text="确认" ground_color="#FF5500FF" text_color="#FFFFFFFF" font_name="fonts/msyh.ttf" font_size="20" />
            <widget size="20,0"/>
            <button name="btn_close" size="100,50" text="关闭"  text_color="#555555FF" font_name="fonts/msyh.ttf" font_size="20" />
        </hlayout>

        <vlayout name="hlay_card_group" pad="20,20" size="0,400">

          <hlayout name="hlay_tools" pad="10,10" size="0,50" can_dropin="true" border_color="#008800FF" border_size="2">
            <label text="@ui_rank_mark" text_color="#333333FF" font_size="20" />
            <label name="lbl_rank_chief" size="64,39" texture="ui:rank_chief" ground_color="#FFFFFFFF" can_dragout="true" border_color="#00000000" border_size="0"/>
            <label name="lbl_rank_adviser" size="64,39" texture="ui:rank_advisor" ground_color="#FFFFFFFF" can_dragout="true" border_color="#00000000" border_size="0"/>
            <widget/>
          </hlayout>

          <gridgroup name="grid_cards" pad="20,20" space="16,16" child_size="150,200" rows="0" cols="5" can_dropin="true" ground_color="#F6FAF2EE" border_color="#2F6B3FFF" border_size="2">
          </gridgroup>

        </vlayout>

        <hlayout >
        </hlayout>

        <card_group name="cards_all" size="0,150" can_dropin="true" ground_color="#228822FF" border_color="#000000FF" border_size="1"  overlap="true">
          <card name="test_card" size="150,200" ground_color="#8888FFFF" border_color="#000099FF" border_size="1" border_round="10" can_dragout="true">
            <vlayout name="cards-test" pad="5,5" accept_event="false">
              <hlayout size="0,25" accept_event="false">
                <label name="lbl_name" size="50,0" text="zhangsan" text_color="#222222FF" font_size="12" accept_event="false"/>
                <widget accept_event="false"/>
                <label name="lbl_level" size="50,0" text="lv.43" text_color="#008800FF" font_size="10" accept_event="false"/>
                <widget accept_event="false"/>
                <label name="lbl_major" size="50,0" text="@major_warrior" text_color="#FF0000FF" font_size="10" accept_event="false"/>
              </hlayout>
              <hlayout size="0,100" accept_event="false">
                <widget  accept_event="false"/>
                <label name="lbl_icon" size="100,0" texture="ui:one-0" ground_color="#FFFFFFFF" border_color="#FFFFFFFF" border_round="5" border_size="3"  accept_event="false"/>
                <widget  accept_event="false"/>
              </hlayout>
              <hlayout>
                <widget size="5,0"/>
                <text name="txt_desc" text="zhangsan is a good man" ground_color="#AAAAAAFF" text_color="#555555FF" font_size="10"  accept_event="false"/>
                <widget size="5,0"/>
              </hlayout>
            </vlayout>
          </card>
        </card_group >
    </vlayout>
</form>
