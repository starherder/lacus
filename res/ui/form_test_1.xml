<?xml version="1.0" encoding="utf-8"?>

<form name="form_test_1"  size="600,500" ground_color="#005555FF" border_color="#555555FF" border_size="1">
    <vlayout name="vlay_bg" ground_color="#FF5555FF" border_color="#555555FF" border_size="1">
        <widget size="0, 50" />
        <hlayout name="hlay_head" ground_color="#FF8888FF" border_color="#00FF00FF" border_size="1">
            <label name="lbl_head" text="what the hell" text_color="#FFFFFFFF" font_name="fonts/Vonwaon.ttf" font_size="30" />
        </hlayout>
        <hlayout name="hlay_footer" pad="10,10" size="0, 100" ground_color="#FF0088FF" border_color="#000000FF" border_size="1">
            <button name="btn_confirm" text="confirm" text_color="#008800FF" font_name="fonts/Vonwaon.ttf" font_size="30" />
            <widget size="10,0" />
            <button name="btn_cancel" text="cancel" text_color="#000099FF" font_name="fonts/Vonwaon.ttf" font_size="30" />
        </hlayout>
        <hlayout name="hlay_title" size="0,50" ground_color="#FFFFAAFF" border_color="#000000FF" border_size="1">
            <widget ground_color="#FFAAFFFF" />
            <label name="lbl_txt" text="hello,world" text_color="#FFCCAAFF" font_name="fonts/Vonwaon.ttf" font_size="30" />
            <button name="btn_close" size="100,50" text="关闭"  text_color="#FFFFFFFF" text_font="fonts/msyh.ttf" font_size="20" />
        </hlayout>
    </vlayout>
</form>