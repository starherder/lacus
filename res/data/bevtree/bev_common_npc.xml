<?xml version="1.0" encoding="UTF-8"?>

<bev>
  <bt name="idle_npc">
    <sequence>
      <repeater count="3">
          <move name="idle_npc_move" speed="200"/>
      </repeater>
    </sequence>
  </bt>

  <bt name="boring_npc">
    <sequence>
      <move name="boring_npc_move" speed="100"/>
      <resize name="boring_npc_resize" target_x="100" target_y="100"/>
      <alpha name="boring_npc_alpha" />
    </sequence>
  </bt>
  
  <bt name="crazy_npc">
    <parallel>
      <move name="crazy_npc_move" speed="100"/>
      <resize name="crazy_npc_resize" target_x="150" target_y="150"/>
      <hue name="crazy_npc_hue" />
    </parallel>
  </bt>
  
  <bt name="npc_patrol">
      <sequence>
          <parallel fail_on_all="false" success_on_all="false" >
            <sequence>
              <patrol_findpath />
              <patrol_move />
            </sequence>
            <pick_item/>
          </parallel>
          <patrol_idle time="2.0" />
      </sequence>
  </bt>

</bev>